{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAIGENT快捷翻譯",
  "version": "0.1.0",
  "identifier": "com.felixchiu.screen-translator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAIGENT快捷翻譯",
        "width": 800,
        "height": 600
      },
      {
        "label": "quick",
        "title": "SAIGENT快捷翻譯 - 劃詞翻譯",
        "url": "index.html?mode=quick",
        "width": 460,
        "height": 340,
        "minWidth": 320,
        "minHeight": 200,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "shadow": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "dlls/*": "./"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
